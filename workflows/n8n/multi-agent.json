{
  "name": "DevBrain Multi-Agent Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "devbrain/question",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3737/api/chat",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "question",
              "value": "={{ $json.body.question }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Code Brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 200]
    },
    {
      "parameters": {
        "url": "http://localhost:3737/api/debug/audit",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "options": {}
      },
      "name": "Debug Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 400]
    },
    {
      "parameters": {
        "url": "http://localhost:3737/api/git/analyze",
        "options": {}
      },
      "name": "Git Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 600]
    },
    {
      "parameters": {
        "mode": "mergeByIndex",
        "options": {}
      },
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { chat: $node['Code Brain'].json.answer, debug: $node['Debug Agent'].json, git: $node['Git Agent'].json } }}"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          { "node": "Code Brain", "type": "main", "index": 0 },
          { "node": "Debug Agent", "type": "main", "index": 0 },
          { "node": "Git Agent", "type": "main", "index": 0 }
        ]
      ]
    },
    "Code Brain": {
      "main": [[{ "node": "Merge Results", "type": "main", "index": 0 }]]
    },
    "Debug Agent": {
      "main": [[{ "node": "Merge Results", "type": "main", "index": 1 }]]
    },
    "Git Agent": {
      "main": [[{ "node": "Merge Results", "type": "main", "index": 2 }]]
    },
    "Merge Results": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  }
}
