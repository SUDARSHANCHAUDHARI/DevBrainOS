{
  "name": "devbrainos",
  "version": "1.0.0",
  "description": "DevBrainOS — AI that understands your entire codebase. Local-first, multi-agent, persistent memory.",
  "main": "apps/cli/index.ts",
  "bin": {
    "devbrain": "./apps/cli/index.ts"
  },
  "scripts": {
