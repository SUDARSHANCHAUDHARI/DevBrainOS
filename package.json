    "git-analysis": "ts-node apps/cli/index.ts git",
    "summary": "ts-node apps/cli/index.ts summary",
    "status": "ts-node apps/cli/index.ts status",
    "clear": "ts-node apps/cli/index.ts clear",
    "server": "ts-node apps/api/server.ts",
    "dev": "nodemon --exec ts-node apps/api/server.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.2",
